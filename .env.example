# ===== 数据库（单源真理：MySQL 容器与后端连接共用这一组值，只改这里，两边同时生效）=====
# MySQL root 密码（仅用于容器内本地管理；后端应用不直接用 root 连接）
MYSQL_ROOT_PASSWORD=示例_请改成长随机串_RootKx92mQv7Lp4
# 数据库名
MYSQL_DATABASE=llm_kb
# 应用账号（后端以此连接；MySQL 容器首次启动时自动创建，允许远程连接）
MYSQL_USER=kb
MYSQL_PASSWORD=示例_请改成长随机串_AppWb58nR3tY6u
# 数据库主机/端口：默认 mysql（compose 内置 MySQL 容器，随项目一起打包）；
# 改用宿主机或外部 MySQL 时设为 host.docker.internal 或实际地址，
# 并用 docker compose up -d --scale mysql=0 关闭内置容器
DB_HOST=mysql
DB_PORT=3306

# 注意：MySQL 容器只在【首次启动】（数据卷为空）时用上面的值建库建号；
# 之后修改这些值不会回写已存在的容器数据卷，需 docker compose down -v 清卷重建（会清空数据）。

# ===== 构建期源覆盖（可选，一般不用动）=====
# pip 源（默认官方源 https://pypi.org/simple；国内无代理服务器可换清华源）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# npm 源（默认 https://registry.npmmirror.com）
# NPM_REGISTRY=https://registry.npmjs.org

# ===== 其余后端配置 =====
# 管理接口令牌（必填；生成：python -c "import secrets; print(secrets.token_urlsafe(32))"）
ADMIN_TOKEN=VFMC57JjGS0OU1kcr4NJXdv8t7eOGESrGsYGMNDCLHI

# 微信小程序登录（没有小程序可留空，相关接口将不可用）
WX_MINI_APPID=
WX_MINI_SECRET=

# 可选：Redis 缓存。启用 compose 的 redis profile 后取消注释
# REDIS_URL=redis://redis:6379/0

# 评论 IP 脱敏盐（必填，换成随机串并保密；泄露后历史 IP 哈希可被撞库）
IP_SALT=Y9dePrwcc8UiNgD3ckhmJRgOaL3qaBwZ

# ===== 说明 =====
# 本文件位于项目根，供 docker compose 读取（compose 还会把这里的值注入 backend 容器）。
# 本地开发（start.bat / start.sh）不走这里：后端本地开发默认连 127.0.0.1:3306 的 root/root，
# 如需覆盖请创建 backend/.env（见 backend/app/core/config.py）。
